              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cargotrace.test\",\n  \"password\": \"CargoTraceDemo!2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload.token) {",
                  "  pm.collectionVariables.set(\"token\", payload.token);",
                  "}"
                ]
              }
            }
          ]
