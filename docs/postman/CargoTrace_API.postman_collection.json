                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Copy the returned token into the collection variable token. Never commit a real token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your-role-account@example.test\",\n  \"password\": \"YOUR_LOCAL_PASSWORD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload.token) {",
                  "  pm.collectionVariables.set(\"token\", payload.token);",
                  "}"
                ]
              }
            }
          ]
        },
